<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminMaster.master.cs" Inherits="CafeandfoodRestaurant.Admin.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Panel - Cafe Sfood</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Segoe UI',sans-serif;
            background: #f4f6f9;
        }

        .offcanvas a {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-weight: 500;
        }

            .offcanvas a:hover {
                background: #f1f1f1;
                border-radius: 6px;
            }
        /* TOP NAVBAR */

     .topbar {
    background: #111827;
    color: white;
    padding: 12px 20px;
    height: 60px;   /* ✅ important */
}

            .topbar .admin-title {
                font-size: 20px;
                font-weight: 600;
            }

        /* SIDEBAR */

     .sidebar {
    width: 230px;
    height: calc(100vh - 60px); /* ✅ adjust height */
    position: fixed;
    top: 60px;                  /* ✅ push below navbar */
    background: #1f2937;
    padding-top: 20px;
    overflow-y: auto;
}
            .sidebar a {
                display: block;
                padding: 12px 20px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 15px;
                transition: 0.3s;
            }

                .sidebar a:hover {
                    background: #374151;
                    color: white;
                }

            .sidebar i {
                margin-right: 10px;
            }

        /* MAIN CONTENT */

       /* TOP NAVBAR FIXED */
.topbar {
    background: #111827;
    color: white;
    padding: 12px 20px;
    height: 60px;

    position: fixed;   /* ✅ FIXED */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;     /* ✅ stays above everything */
}

/* SIDEBAR */
.sidebar {
    width: 230px;
    height: calc(100vh - 60px);

    position: fixed;
    top: 60px; /* ✅ EXACTLY below navbar */
    left: 0;

    background: #1f2937;
    padding-top: 20px;
    overflow-y: auto;
}

/* MAIN CONTENT */
.main-content {
    margin-left: 230px;
    margin-top: 60px;  /* ✅ IMPORTANT to avoid overlap */
    padding: 25px;
}

        /* CARDS */

        .dashboard-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        /* MOBILE */

        @media(max-width:768px) {

            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1" runat="server">

        <!-- TOP NAVBAR -->

        <nav class="topbar d-flex justify-content-between align-items-center">

            <div>

                <button type="button" class="btn btn-light d-md-none"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileMenu"
                    aria-controls="mobileMenu">
                    <i class="fa fa-bars"></i>
                </button>
                <span class="admin-title ms-2">
                    <i class="fa fa-utensils"></i>Admin Panel
                </span>

            </div>

            <div>
                <i class="fa fa-user-circle"></i>Admin
            </div>

        </nav>


        <!-- DESKTOP SIDEBAR -->

        <div class="sidebar d-none d-md-block">
            <a class="d-block mb-2" href="Dashboard.aspx">
                <i class="fa fa-chart-line"></i>Dashboard
            </a>
                <a class="d-block mb-2" href="Analytics.aspx">
                <i class="fa fa-edit"></i>Analytics
            </a>
             </a>
                <a class="d-block mb-2" href="AllData.aspx">
                <i class="fa fa-edit"></i>Report
            </a>
           <a class="d-block mb-2" href="ChangePassword.aspx">
    <i class="fa fa-cog"></i> Settings
</a>

<a class="d-block mb-2" href="AddFoodCategories.aspx">
    <i class="fa fa-list"></i> Add Categories
</a>
            <a class="d-block mb-2" href="AddMenu.aspx">
                <i class="fa fa-plus-circle"></i>Add Menus
            </a>

            <a class="d-block mb-2" href="ViewMenu.aspx">
                <i class="fa fa-eye"></i>View Menus
            </a>

        
            <a class="d-block mb-2" href="TableInfo.aspx">
                <i class="fa fa-burger"></i>Table Management
            </a>

            <a class="d-block mb-2" href="ViewOrders.aspx">
                <i class="fa fa-shopping-cart"></i>Orders
            </a>

            <a class="d-block mb-2" href="TakeActionTableOrder.aspx">
                <i class="fa fa-chair"></i>Table Bookings
            </a>
             <a class="d-block mb-2" href="AddPLans.aspx">
                <i class="fa fa-plus-circle"></i>Add Plans
            </a>
            <a class="d-block mb-2" href="ViewPlans.aspx">
                <i class="fa fa-crown"></i>Membership
            </a>

            <a class="d-block mb-2" href="UserList.aspx">
                <i class="fa fa-users"></i>Users
            </a>

            <a class="d-block mb-2" href="Chart.aspx">
                <i class="fa fa-chart-bar"></i>Charts
            </a>

            <a class="d-block mb-2 text-danger" href="../Default.aspx">
                <i class="fa fa-sign-out-alt"></i>Logout
            </a>
        </div>


        <!-- MOBILE SIDEBAR -->

        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">

            <div class="offcanvas-header">

                <h5 class="offcanvas-title">
                    <i class="fa fa-utensils"></i>Admin Menu
                </h5>

                <button class="btn btn-light d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
            </div>

            <div class="offcanvas-body">

                <a class="d-block mb-2" href="Dashboard.aspx">
                    <i class="fa fa-chart-line"></i>Dashboard
                </a>
                    <a class="d-block mb-2" href="Analytics.aspx">
                <i class="fa fa-edit"></i>Analytics
            </a>
             <a class="d-block mb-2" href="ChangePassword.aspx">
    <i class="fa fa-cog"></i> Settings
</a>

<a class="d-block mb-2" href="AddFoodCategories.aspx">
    <i class="fa fa-list"></i> Add Categories
</a>
                <a class="d-block mb-2" href="AddMenu.aspx">
                    <i class="fa fa-plus-circle"></i>Add Menus
                </a>

              <!-- VIEW MENU WITH SUBMENU -->
<a class="d-block mb-2" data-bs-toggle="collapse" href="#viewMenuSub">
    <i class="fa fa-eye"></i> View Menu
</a>

<div class="collapse ps-3" id="viewMenuSub">

    <a href="ViewMenu.aspx?cat=Veg">Veg</a>
    <a href="ViewMenu.aspx?cat=MainCourse">Main Course</a>
    <a href="ViewMenu.aspx?cat=Breakfast">Breakfast</a>
    <a href="ViewMenu.aspx?cat=Beverage">Beverage</a>
    <a href="ViewMenu.aspx?cat=Thali">Thali</a>
    <a href="ViewMenu.aspx?cat=NonVeg">Non-Veg</a>
    <a href="ViewMenu.aspx?cat=StudentSpecial">Student Special</a>
    <a href="ViewMenu.aspx?cat=Drinks">Drinks</a>
    <a href="ViewMenu.aspx?cat=Dessert">Dessert</a>

</div>

            <%--    <a class="d-block mb-2" href="EditMenu.aspx">
                    <i class="fa fa-edit"></i>Edit Menus
                </a>--%>

                <a class="d-block mb-2" href="TableInfo.aspx">
                    <i class="fa fa-burger"></i>Table Management
                </a>

                <a class="d-block mb-2" href="ViewOrders.aspx">
                    <i class="fa fa-shopping-cart"></i>Orders
                </a>

                <a class="d-block mb-2" href="TakeActionTableOrder.aspx">
                    <i class="fa fa-chair"></i>Table Bookings
                </a>

                <a class="d-block mb-2" href="ViewPlans.aspx">
                    <i class="fa fa-crown"></i>Membership
                </a>

                <a class="d-block mb-2" href="UserList.aspx">
                    <i class="fa fa-users"></i>Users
                </a>

                <a class="d-block mb-2" href="Chart.aspx">
                    <i class="fa fa-chart-bar"></i>Reports
                </a>

                <a class="d-block mb-2 text-danger" href="../Default.aspx">
                    <i class="fa fa-sign-out-alt"></i>Logout
                </a>

            </div>

        </div>


        <!-- PAGE CONTENT -->

        <div class="main-content">

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
