<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="HomemasterPage.master.cs" Inherits="CafeandfoodRestaurant.HomemasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>☕ Ladachi Coffee</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>

body {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
}

/* ===== HEADER ===== */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 50px;
    background: black;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    color: white;
}

.navbar {
    display: flex;
}

.navbar a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
}

.navbar a:hover {
    color: orange;
}

.icon-container i {
    color: white;
    margin-left: 15px;
}

/* MOBILE MENU */
.menu-toggle {
    display: none;
    color: white;
    font-size: 22px;
    cursor: pointer;
}

/* DROPDOWN */
.dropdown {
    position: relative;
}

.dropdown-content {
    display: none;
    position: absolute;
    background: #2c2c2c;
    min-width: 150px;
    border-radius: 5px;
}

.dropdown-content a {
    display: block;
    padding: 10px;
}

.dropdown:hover .dropdown-content {
    display: block;
}

/* ===== HERO ===== */
.hero {
    position: relative;
    height: 80vh;
}

.hero video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    color: white;
    text-align: center;
}

.hero-text h1 {
    font-size: 50px;
}

.hero-text span {
    font-size: 20px;
}

/* ===== SECTION ===== */
.tan {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 50px;
    gap: 30px;
}

.tan .image img {
    width: 400px;
    border-radius: 10px;
}

/* ===== FOOTER ===== */
.footer {
    background: black;
    color: white;
    padding: 40px;
}

.footer-container {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.footer-box {
    flex: 1;
    min-width: 200px;
    margin: 10px;
}

.footer a {
    display: block;
    color: white;
    text-decoration: none;
    margin: 5px 0;
}

.footer a:hover {
    color: orange;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {

    .header {
        padding: 15px 20px;
    }

    .menu-toggle {
        display: block;
    }

    .navbar {
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: black;
        flex-direction: column;
        display: none;
        text-align: center;
    }

    .navbar a {
        padding: 15px;
        border-top: 1px solid #333;
    }

    .navbar.active {
        display: flex;
    }

    .icon-container {
        display: none;
    }

    .hero-text h1 {
        font-size: 28px;
    }

    .hero-text span {
        font-size: 16px;
    }

    .tan {
        flex-direction: column;
        padding: 20px;
    }

    .tan .image img {
        width: 100%;
    }

    .footer-container {
        flex-direction: column;
    }
}

</style>

<asp:ContentPlaceHolder ID="head" runat="server" />

</head>

<body>

<form id="form1" runat="server">

<asp:ScriptManager ID="ScriptManager1" runat="server" />

<!-- ===== HEADER ===== -->
<header class="header">

    <h4 class="logo">☕ Cafe & Food </h4>

    <div class="menu-toggle" onclick="toggleMenu()">
        <i class="fas fa-bars"></i>
    </div>

    <nav class="navbar" id="navMenu">
        <a href="Default.aspx">Home</a>
        <a href="Register.aspx">Register</a>
                <a href="ProductList.aspx">Menu</a>


        <div class="dropdown">
            <a href="#">Login ▾</a>
            <div class="dropdown-content">
                <a href="Login.aspx">User</a>
                <a href="AdminLogin.aspx">Admin</a>
            </div>
        </div>
    </nav>

    <div class="icon-container">
    
        <a href="Login.aspx"><i class="fas fa-user"></i></a>
    </div>

</header>

<!-- ===== HERO ===== -->
<div class="hero">
    <video autoplay loop muted>
        <source src="images/20250213_201533.mp4" type="video/mp4">
    </video>

    <div class="hero-text">
        <h1>START YOUR DAY WITH<br />LADACHI COFFEE</h1>
        <span>Good Morning, But Coffee First ☕</span>
    </div>
</div>

<!-- ===== PAGE CONTENT ===== -->
<div class="container mt-4">
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
</div>

<!-- ===== SECTION ===== -->
<section class="tan">
    <div class="text">
        <h2>We believe this is the best coffee in India.</h2>
        <p>Our roasts feature multiple underlying notes. Experience premium taste.</p>
    </div>

    <div class="image">
        <img src="images/girl_with_coffee.jpg" />
    </div>
</section>

<!-- ===== FOOTER ===== -->
<footer class="footer">

    <div class="footer-container">

        <div class="footer-box">
            <h3>☕ Cafe & Food</h3>
            <p>Best coffee experience in town.</p>
        </div>

        <div class="footer-box">
            <h4>Links</h4>
            <a href="#">Home</a>
            <a href="Register.aspx">Register</a>
            <a href="Login.aspx">Login</a>
        </div>

        <div class="footer-box">
            <h4>Contact</h4>
            <p>Phone: +91 8888430689</p>
        </div>

    </div>

</footer>

</form>

<!-- SCRIPT -->
<script>
function toggleMenu() {
    document.getElementById("navMenu").classList.toggle("active");
}
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>