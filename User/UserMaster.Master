    <title>Cafe Sfood Restaurant</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        <style >

        body {
            font-family: 'Segoe UI',sans-serif;
            background: #f4f6f9;
        }

        /* Navbar */

        .navbar {
            background: linear-gradient(45deg,#0f4c5c,#1f7a8c);
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .navbar-brand {
            font-size: 22px;
            font-weight: 600;
            color: #fff !important;
        }

        .nav-link {
            color: white !important;
            margin-right: 15px;
            font-weight: 500;
            transition: 0.3s;
        }

            .nav-link:hover {
                color: #ffd166 !important;
            }

        /* Dropdown */

        .dropdown-menu {
            border-radius: 10px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

        .dropdown-item:hover {
            background: #0f4c5c;
            color: white;
        }

        /* Content */

        .content-wrapper {
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        /* Footer */

        .footer {
            background: #0f4c5c;
            color: white;
            text-align: center;
            padding: 12px;
            margin-top: 20px;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

